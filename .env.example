# Local PostgreSQL user for docker compose.
POSTGRES_USER=app

# Local PostgreSQL password for docker compose. Replace in real environments.
POSTGRES_PASSWORD=app_secret

# Local PostgreSQL database name for docker compose.
POSTGRES_DB=app

# Backend listen port exposed on host.
BACKEND_PORT=8080

# Frontend listen port exposed on host.
FRONTEND_PORT=3000

# Browser-facing backend base URL for frontend builds.
NEXT_PUBLIC_API_URL=http://localhost:8080
